extends SceneTree
const Sim = preload("res://sim/core/simulation.gd")
const Health = preload("res://sim/player/body_health.gd")
const Inventory = preload("res://sim/inventory/inventory_store.gd")
const Save = preload("res://sim/persistence/save_manager.gd")
const Checks = preload("res://sim/diagnostics/invariants.gd")
var failures: int=0
func check(value: bool,label: String) -> void:
	if not value: failures+=1; printerr("FAIL: "+label)
func _initialize() -> void:
	var sim:=Sim.new(); sim.start_game()
	var s: Dictionary=sim.state
	check(s.player_health.parts.size()==17 and Health.overall(s)==100,"Healthy complete body")
	sim.submit("debug_injury",{"part":"right_hand","damage":24,"kind":"cut"}); sim.step()
	Health.injure(s,"left_shin",40,"sprain")
	check(s.player_health.parts.right_hand.bleeding and Health.move_delay(s)==2,"Injuries affect bleeding and movement")
	var bandages: int=Inventory.amount(s,s.player,"bandage")
	sim.submit("treat_body",{"part":"right_hand","action":"bandage"}); sim.step()
	sim.submit("move_player",{"direction":[1,0]}); sim.step()
	check(s.player_health.treatment.is_empty() and Inventory.amount(s,s.player,"bandage")==bandages,"Movement cancels without consuming supplies")
	sim.submit("treat_body",{"part":"right_hand","action":"bandage"}); sim.step()
	var restored:=Sim.new(); restored.restore(sim.snapshot())
	for tick in range(40): sim.step(); restored.step()
	check(sim.state_hash()==restored.state_hash(),"Treatment continuation is exact after reload")
	check(s.player_health.parts.right_hand.bandage=="clean" and not s.player_health.parts.right_hand.bleeding and Inventory.amount(s,s.player,"bandage")==bandages-1,"Completed bandage consumes one item and stops bleeding")
	var damage: int=s.player_health.parts.right_hand.damage
	for tick in range(300): sim.step()
	check(s.player_health.parts.right_hand.damage<damage,"Bandaged damage heals with time")
	for tick in range(1100): sim.step()
	check(s.player_health.parts.right_hand.bandage=="dirty","Bandages become dirty")
	sim.submit("treat_body",{"part":"right_hand","action":"remove"}); sim.step()
	for tick in range(12): sim.step()
	var disinfectant: int=Inventory.amount(s,s.player,"antiseptic")
	sim.submit("treat_body",{"part":"right_hand","action":"disinfect"}); sim.step()
	for tick in range(32): sim.step()
	check(Inventory.amount(s,s.player,"antiseptic")==disinfectant-1 and s.player_health.parts.right_hand.infection==0,"Cleaning consumes supply and reduces infection")
	var bad: Dictionary=sim.snapshot(); bad.player_health.parts.head.damage=-1
	check(not Save.validate_schema(bad).is_empty(),"Invalid body damage rejected")
	check(Checks.validate(s).is_empty(),"Treatment conserves accounted supplies")
	var legacy: Dictionary=sim.snapshot(); legacy.erase("player_health"); legacy.erase("player_control")
	var migrated:=Sim.new(); migrated.restore(legacy)
	var hash_value: String=migrated.state_hash(); migrated.restore(migrated.snapshot())
	check(migrated.state_hash()==hash_value,"Health upgrade occurs once")
	print("Player health: %s" % ("PASS" if failures==0 else "FAIL")); quit(0 if failures==0 else 1)
